# ----- LM Studio (local Gemma 4) -----
# Start LM Studio, load a Gemma 4 VLM, and click "Start Server" in the
# Developer tab. Default endpoint is http://localhost:1234/v1.
#
# To list loaded models:
#   curl http://localhost:1234/v1/models
#
# The LMSTUDIO_MODEL value must match an "id" returned by the endpoint above.
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=google/gemma-4-26b-a4b
# Any non-empty string works — LM Studio ignores the key.
LMSTUDIO_API_KEY=lm-studio

# ----- Supabase (auth + db) -----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ----- Resend (email alerts) -----
RESEND_API_KEY=

# ----- Vercel Blob (archive storage) -----
BLOB_READ_WRITE_TOKEN=

# ----- OpenAI (assistant chatbot only — optional) -----
# The VLM frame analysis uses LM Studio above. This key is only needed
# if you want to keep the contextual assistant chatbot powered by OpenAI.
OPENAI_API_KEY=
